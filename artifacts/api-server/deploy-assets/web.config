<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!-- ═══════════════════════════════════════════════════════════════════
         iisnode — routes requests to Node.js via a named pipe
         ═══════════════════════════════════════════════════════════════════ -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <iisnode
      node_env="production"
      nodeProcessCommandLine="node.exe"
      loggingEnabled="true"
      logDirectory="iisnode-logs"
      debuggingEnabled="false"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250"
      maxRequestBufferSize="4194304"
      uncFileChangesPollingInterval="5000"
    />

    <!-- ═══════════════════════════════════════════════════════════════════
         URL Rewrite — send everything through Node EXCEPT true static files
         ═══════════════════════════════════════════════════════════════════ -->
    <rewrite>
      <rules>

        <!-- 1. Never rewrite requests that map to an existing file on disk
                (JS chunks, CSS, images, fonts, the video, etc.)          -->
        <rule name="StaticFiles" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- 2. Route everything else (API + SPA routes) to server.js     -->
        <rule name="NodeApp" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>

      </rules>
    </rewrite>

    <!-- ═══════════════════════════════════════════════════════════════════
         Static-file caching headers
         ═══════════════════════════════════════════════════════════════════ -->
    <staticContent>
      <!-- cache-busted Vite assets — 1 year -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>

    <!-- ═══════════════════════════════════════════════════════════════════
         Security — block direct access to server internals
         ═══════════════════════════════════════════════════════════════════ -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="iisnode-logs" />
        </hiddenSegments>
        <fileExtensions>
          <!-- Block source map leakage in production -->
          <add fileExtension=".map" allowed="false" />
        </fileExtensions>
        <denyUrlSequences>
          <add sequence="web.config" />
          <add sequence="package.json" />
        </denyUrlSequences>
      </requestFiltering>
    </security>

    <!-- Increase limits for AI endpoints that may send large payloads -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" /> <!-- 50 MB -->
      </requestFiltering>
    </security>

    <!-- Extend IIS request timeout (matches the 120 s AI proxy timeout) -->
    <limits connectionTimeout="150" />

    <!-- Custom error pages — let Node/SPA handle 404 -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
